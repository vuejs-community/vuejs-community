{
  "name": "@vue-community/schema",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*.d.mts",
        "./*"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "devDependencies": {
    "@lonewolfyx/tsconfig": "^0.0.6",
    "@types/node": "^26.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  }
}
